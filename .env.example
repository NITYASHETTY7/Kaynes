# Optional — the POC runs fully offline without any keys.
# Set this only if you want the "AI Device Diagnostic" to call a live model.
# The key stays server-side (used by /api/analyze.js), never shipped to the browser.
GEMINI_API_KEY=
# Optional model override (defaults to gemini-2.5-flash).
GEMINI_MODEL=gemini-2.5-flash
